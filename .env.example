# Copy this file to .env and fill in the values. Never commit .env to Git.

APP_NAME="AM Tuff Tiles"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Karachi

# Database (Hostinger: hPanel > Databases > Management)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# Shop contact details (shown in the footer and contact page)
SHOP_EMAIL=tufftilesam@gmail.com
SHOP_PHONE=03003715684
SHOP_WHATSAPP=+923003715684
SHOP_ADDRESS=

# Social pages (shown in the footer and on the About page when filled in)
SHOP_FACEBOOK=https://www.facebook.com/p/AM-Tuff-Tiles-61555668119271/
SHOP_INSTAGRAM=

# Google Map above the footer on Home and About. Fill ONE of these (nothing is shown while both are empty):
#  SHOP_MAP_EMBED = the address inside src="..." from Google Maps > Share > Embed a map
#  SHOP_MAP_QUERY = your shop address or place name, e.g. AM Tuff Tiles, Street, City
SHOP_MAP_EMBED=
SHOP_MAP_QUERY=
# Optional: your Google Maps share link, used by the "Open in Google Maps" button
SHOP_MAP_LINK=
